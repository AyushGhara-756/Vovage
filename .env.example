# Supabase (browser-safe values are prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Server-only (Flask / Next server) — never expose to the browser
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-service-key

# Flask JWT fallback if the project uses HS256 signing keys (omit for ES256/RS256)
SUPABASE_JWT_SECRET=

# Optional CORS origin(s) for the Flask account API (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000

# Flask runtime (production: APP_ENV=production, https FRONTEND_ORIGIN, FLASK_DEBUG=0)
APP_ENV=development
HOST=127.0.0.1
PORT=6050
FLASK_DEBUG=0
# Trust X-Forwarded-For. Loopback proxies are trusted automatically;
# set to 1 for a trusted reverse proxy on another host.
TRUST_PROXY=0

# Abuse protection (0 disables a limit; SERP_DAILY_CALL_LIMIT=0 means uncapped)
RATE_LIMIT_SEARCH_PER_MINUTE=20
RATE_LIMIT_PREDICT_PER_MINUTE=60
RATE_LIMIT_ACCOUNT_PER_MINUTE=60
RATE_LIMIT_API_PER_MINUTE=120
SERP_DAILY_CALL_LIMIT=200

# Travel search providers
SERP_API=your-serpapi-key
AVAITION_API=your-aviationstack-key
