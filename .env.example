# Supabase (browser-safe values are prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Server-only (Flask / Next server) — never expose to the browser
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-service-key

# Flask JWT fallback if the project uses HS256 signing keys (omit for ES256/RS256)
SUPABASE_JWT_SECRET=

# Optional CORS origin(s) for the Flask account API (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000

# Travel search providers
SERP_API=your-serpapi-key
AVAITION_API=your-aviationstack-key
